# ── LYRA — Environment Configuration Template ───────────────────────────
# Copy this file to .env and fill in your private API keys.
# NEVER commit .env to version control. Keep all secret keys server-side.

# ── LLM Providers (Server-Side Only) ──────────────────────────────────
# At least one provider key is required for cloud reasoning.
# For 100% offline local inference, install Ollama (http://localhost:11434).
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Model Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=llama3.2

# ── Voice (macOS native speech) ──────────────────────────────────────
TTS_VOICE=Samantha
TTS_RATE=185

# ── Server Configuration ──────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8100
# Optional absolute path; otherwise uses lyra-backend/data/lyra.db.
# DATABASE_PATH=/absolute/path/to/lyra.db

# Speech: auto prefers an explicitly installed local model.
STT_PROVIDER=auto
LOCAL_STT_MODEL=tiny
# LOCAL_STT_MODEL_DIR=/absolute/path/to/faster-whisper-tiny
# GROQ_STT_MODEL=whisper-large-v3-turbo
# OPENAI_STT_MODEL=whisper-1

# Restrict file tools and retrieval to your chosen project directories.
# LYRA_WORKSPACE_ROOTS=/absolute/path/to/your/workspace
# Optional Claude Code executable for the Claude Code tool.
# CLAUDE_BINARY_PATH=/absolute/path/to/claude
